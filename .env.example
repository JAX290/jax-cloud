# ===== Payload =====
PAYLOAD_SECRET=change-me-to-a-long-random-string
DATABASE_URL=file:./jax.db
SERVER_URL=http://localhost:3000
SITE_ADDRESS=cloud.jax.markets

# ===== 邮件（开发默认走本地 SMTP 捕获器 127.0.0.1:1025）=====
# 生产改成你的企业邮箱 SMTP
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@jax.markets
EMAIL_FROM_NAME=JAX CLOUD

# 搜索引擎站点验证（可选，配置后重启应用生效；值只填 content 里的那串）
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# IndexNow（Bing 主动推送，key 文件在 public/<key>.txt）
INDEXNOW_KEY=

# 主控 Tailscale 地址（换服务器只改这一行；Caddy、工作台面板链接都用它）
PANEL_HOST=100.124.251.8

# ---- 业务参数（可选，不填用默认值）----
# 到期后宽限天数（这段时间仍可用，只提醒不中断）
GRACE_DAYS=1
# 体验时长与流量
TRIAL_HOURS=1
TRIAL_GB=1
# 续费提醒窗口所在时区的小时偏移（8=北京时间）
CRON_TZ_OFFSET=8
